# Examples only; the application does not automatically read this file.
DJANGO_SETTINGS_MODULE=config.production
DJANGO_SECRET_KEY=replace-with-a-new-random-secret-at-least-50-characters-long
DJANGO_ALLOWED_HOSTS=your-app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.example.com
DATABASE_URL=postgresql://user:password@database-host:5432/stuff
DJANGO_MEDIA_ROOT=/var/data/private-media
DJANGO_TRUST_PROXY=1
